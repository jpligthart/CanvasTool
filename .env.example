# Local compose only. Production (docker-scripts/canvastool) stays on port 8320, container canvastool.
COMPOSE_PROJECT_NAME=canvastool-dev
CANVASTOOL_HOST_PORT=8321
# Registry/repo without tag. Used by compose (:local) and scripts/build-and-push.ps1 (:VERSION + :latest).
CANVASTOOL_IMAGE=your-registry.example.com/org/canvastool

CANVAS_BASE_URL=https://your-institution.instructure.com
CANVAS_API_TOKEN=your_canvas_api_token_here
